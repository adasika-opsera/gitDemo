{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gitdemo.local/config/contracts/enums.schema.json",
  "title": "Cross-Language Enum Contract",
  "type": "object",
  "required": ["version", "enums"],
  "additionalProperties": false,
  "properties": {
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "enums": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "$ref": "#/$defs/enumDefinition"
      }
    }
  },
  "$defs": {
    "enumDefinition": {
      "type": "object",
      "required": ["values"],
      "additionalProperties": false,
      "properties": {
        "description": {
          "type": "string"
        },
        "values": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/enumValue"
          }
        }
      }
    },
    "enumValue": {
      "type": "object",
      "required": ["name", "ruby", "js"],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$",
          "not": {
            "pattern": "(secret|token|password|credential|encrypted)"
          }
        },
        "ruby": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "js": {
          "type": "string",
          "pattern": "^[a-zA-Z][a-zA-Z0-9]*$"
        },
        "description": {
          "type": "string"
        },
        "since": {
          "type": "string"
        }
      }
    }
  }
}

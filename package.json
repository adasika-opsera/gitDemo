{
  "name": "gitdemo-frontend",
  "version": "1.0.0",
  "private": true,
  "description": "Demo frontend build baseline, dual-bundler parity, size budget gate, runtime smoke suite, and architecture ratchets (WO-001–WO-006)",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "NODE_ENV=production webpack --config config/webpack.config.js",
    "build:rspack": "NODE_ENV=production rspack build --config config/rspack.config.mjs",
    "compare-bundles": "node scripts/frontend/compare_bundles.mjs",
    "record-baseline": "node scripts/frontend/record_build_baseline.mjs",
    "validate-baseline": "node scripts/frontend/validate_baseline.mjs",
    "check-size-budget": "node scripts/frontend/check_size_budget.mjs",
    "smoke-entry-points": "node scripts/frontend/smoke_entry_points.mjs",
    "record-layer-baseline": "node scripts/architecture/record_layer_baseline.mjs",
    "check-layer-ratchet": "node scripts/architecture/check_layer_ratchet.mjs",
    "check-ruby-ratchet": "node scripts/architecture/check_ruby_ratchet.mjs",
    "test": "jest",
    "test:baseline": "jest tests/frontend/manifestNormalizer.test.js",
    "test:parity": "jest tests/frontend/compareBundles.test.js",
    "test:size-budget": "jest tests/frontend/checkSizeBudget.test.js",
    "test:smoke": "jest tests/frontend/smokeEntryPoints.test.js",
    "test:architecture": "jest tests/architecture/layerRatchet.test.js"
  },
  "devDependencies": {
    "@rspack/cli": "^1.7.12",
    "@rspack/core": "^1.7.12",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "dependency-cruiser": "^16.10.4",
    "jest": "^29.7.0",
    "js-yaml": "^4.1.0",
    "puppeteer": "^24.43.1",
    "webpack": "^4.47.0",
    "webpack-cli": "^4.10.0"
  }
}
